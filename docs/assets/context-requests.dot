// Public architecture only; no account, deployment or conversation identifiers.
digraph G {
  graph [rankdir=TB,bgcolor="white",pad="0.3",nodesep="0.4",ranksep="0.55",
    label="AgentPeers: factual-context prototype",labelloc=t,fontsize=22,fontname="Arial"];
  node [shape=box,style="rounded,filled",fillcolor="#f6f8fb",color="#67768b",
    fontname="Arial",fontsize=14,margin="0.18,0.12"];
  edge [fontname="Arial",fontsize=11,color="#2c7057",penwidth=1.5];
  chat [label="Ordinary ChatGPT chat\nrequest_context / context_result"];
  oauth [label="Separate requester OAuth grant\nowner-approved conversation binding\nmetadata correlates; bearer authenticates"];
  service [label="Existing AgentPeers service\nlinked request / message / sourced result\ndeadline + duplicate suppression"];
  dot [label="Existing Dot receiver\nclaim / read / answer once\nowner-approved factual scope"];
  chat -> oauth [label="request / explicit result retrieval",dir=both];
  oauth -> service [label="only two scoped tools",dir=both];
  service -> dot [label="existing signed message.created / sourced reply",dir=both];
  status [shape=note,fillcolor="#fff2d5",color="#a77512",
    label="Private synthetic Dot round trip verified\nValidation grant closed; adapter disabled by default\nGeneral factual-question setup still to implement\nNo ordinary-chat wake or business-action authority"];
  fixture [shape=note,label="Separate runnable local fixtures\nDot and exact named Codex receiver contract\nNo live Codex context adapter"];
  service -> status [style=dotted,arrowhead=none];
  fixture -> service [style=dotted,arrowhead=none,label="contract tests"];
}
